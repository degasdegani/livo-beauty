generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- TENANT ----------

model Business {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  document          String?
  phone             String?
  businessType      BusinessType @default(SALON)
  prontuarioEnabled Boolean      @default(false)
  hasReception      Boolean      @default(false)
  plan              String       @default("trial")
  inviteCode        String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  businessHours BusinessHours[]
  appointments  Appointment[]
  products      Product[]
  suppliers     Supplier[]
  commands      Command[]
  transactions  Transaction[]
  payables      Payable[]
  notifications Notification[]

  anamneseRecords      AnamneseRecord[]
  anamneseCustomFields AnamneseCustomField[]
  anamnesePhotos       AnamnesePhoto[]

  @@map("businesses")
}

enum BusinessType {
  SALON
  CLINIC
}

// ---------- AUTH (Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(OWNER)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  accounts        Account[]
  sessions        Session[]
  professional    Professional?
  payablePayments PayablePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@map("users")
}

enum UserRole {
  OWNER
  STAFF
  PROFESSIONAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- PROFISSIONAIS + SERVICOS ----------

model Professional {
  id                   String                @id @default(cuid())
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId               String?               @unique
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  phone                String?
  category             ProfessionalCategory  @default(SERVICE_PROVIDER)
  active               Boolean               @default(true)
  services             ProfessionalService[]
  blocks               ProfessionalBlock[]
  appointments         Appointment[]
  pushSubscriptions    PushSubscription[]
  commandItems         CommandItem[]
  professionalProducts ProfessionalProduct[]
  payables             Payable[]
  notifications        Notification[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([businessId])
  @@map("professionals")
}

enum ProfessionalCategory {
  RECEPTION
  SERVICE_PROVIDER
}

model Service {
  id                  String                @id @default(cuid())
  businessId          String
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  durationMinutes     Int
  price               Decimal               @db.Decimal(10, 2)
  active              Boolean               @default(true)
  requiresAnamnese    Boolean               @default(false)
  professionals       ProfessionalService[]
  appointmentServices AppointmentService[]
  commandItems        CommandItem[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([businessId])
  @@map("services")
}

model ProfessionalService {
  id                String       @id @default(cuid())
  professionalId    String
  professional      Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId         String
  service           Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  commissionPercent Decimal      @db.Decimal(5, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([professionalId, serviceId])
  @@map("professional_services")
}

// ---------- AGENDA ----------

model Client {
  id                   String   @id @default(cuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  phone                String
  fullProfileCompleted Boolean  @default(false)

  birthDate DateTime?
  instagram String?
  origin    ClientOrigin?

  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZipCode      String?

  appointments   Appointment[]
  commands       Command[]
  anamneseRecord AnamneseRecord?
  anamnesePhotos AnamnesePhoto[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([businessId])
  @@map("clients")
}

enum ClientOrigin {
  INDICACAO
  INSTAGRAM
  GOOGLE
  FACHADA
  OUTRO
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String
  closeTime  String
  closed     Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model ProfessionalBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
  @@map("professional_blocks")
}

model Appointment {
  id                   String               @id @default(cuid())
  businessId           String
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId       String
  professional         Professional         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  clientId             String
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  startAt              DateTime
  endAt                DateTime
  room                 String?
  status               AppointmentStatus    @default(CONFIRMADO)
  notes                String?
  services             AppointmentService[]
  command              Command?
  anamnesePhotos       AnamnesePhoto[]
  pushReminderSentAt   DateTime?
  source               AppointmentSource    @default(INTERNAL)
  publicManageToken    String?              @unique
  clientReminderSentAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([businessId])
  @@index([professionalId, startAt])
  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  AUSENTE
  REAGENDADO
}

enum AppointmentSource {
  INTERNAL
  PUBLIC_BOOKING
}

model AppointmentService {
  id               String      @id @default(cuid())
  appointmentId    String
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priceSnapshot    Decimal     @db.Decimal(10, 2)
  durationSnapshot Int

  @@map("appointment_services")
}

model PushSubscription {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  endpoint       String       @unique
  p256dh         String
  auth           String
  createdAt      DateTime     @default(now())

  @@index([professionalId])
  @@map("push_subscriptions")
}

model Notification {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           NotificationType
  appointmentId  String?
  message        String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([professionalId, read])
  @@map("notifications")
}

enum NotificationType {
  NOVO_AGENDAMENTO_PUBLICO
}

// ---------- PRODUTOS / ESTOQUE ----------

enum ProductSaleType {
  VENDA
  CONSUMO_INTERNO
  AMBOS
}

model Product {
  id                   String                @id @default(cuid())
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  sku                  String?
  unit                 String
  saleType             ProductSaleType       @default(VENDA)
  salePrice            Decimal?              @db.Decimal(10, 2)
  currentStock         Int                   @default(0)
  lowStockThreshold    Int                   @default(5)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  suppliers            ProductSupplier[]
  commandItems         CommandItem[]
  professionalProducts ProfessionalProduct[]

  @@index([businessId])
  @@map("products")
}

model Supplier {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  contactName String?
  notes       String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductSupplier[]
  payables    Payable[]

  @@index([businessId])
  @@map("suppliers")
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  costPrice  Decimal  @db.Decimal(10, 2)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ---------- FINANCEIRO / COMANDA ----------

enum CommandStatus {
  ABERTA
  FECHADA
  CANCELADA
}

enum DiscountType {
  PERCENTUAL
  FIXO
}

model Command {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentId  String?          @unique
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status         CommandStatus    @default(ABERTA)
  openedAt       DateTime         @default(now())
  closedAt       DateTime?
  discountType   DiscountType?
  discountValue  Decimal?         @db.Decimal(10, 2)
  discountAmount Decimal          @default(0) @db.Decimal(10, 2)
  items          CommandItem[]
  payments       CommandPayment[]
  payables       Payable[]

  @@index([businessId])
  @@map("commands")
}

enum CommandItemType {
  SERVICO
  PRODUTO
}

model CommandItem {
  id                String          @id @default(cuid())
  commandId         String
  command           Command         @relation(fields: [commandId], references: [id], onDelete: Cascade)
  type              CommandItemType
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  professionalId    String
  professional      Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  quantity          Int             @default(1)
  unitPrice         Decimal         @db.Decimal(10, 2)
  commissionPercent Decimal         @db.Decimal(5, 2)
  createdAt         DateTime        @default(now())

  @@index([commandId])
  @@map("command_items")
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

model CommandPayment {
  id        String        @id @default(cuid())
  commandId String
  command   Command       @relation(fields: [commandId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  @@index([commandId])
  @@map("command_payments")
}

model ProfessionalProduct {
  id                String       @id @default(cuid())
  professionalId    String
  professional      Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  commissionPercent Decimal      @db.Decimal(5, 2)

  @@unique([professionalId, productId])
  @@map("professional_products")
}

enum TransactionType {
  RECEITA
  DESPESA
}

model Transaction {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String
  commandId   String?
  payableId   String?
  payable     Payable?        @relation(fields: [payableId], references: [id], onDelete: SetNull)
  occurredAt  DateTime        @default(now())

  @@index([businessId])
  @@index([payableId])
  @@map("transactions")
}

enum PayableStatus {
  PENDENTE
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

enum PayableKind {
  COMISSAO
  FORNECEDOR
  DESPESA_MANUAL
  OUTRO
}

model Payable {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind           PayableKind
  status         PayableStatus    @default(PENDENTE)
  amount         Decimal          @db.Decimal(10, 2)
  description    String
  dueDate        DateTime?
  professionalId String?
  professional   Professional?    @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  commandId      String?
  command        Command?         @relation(fields: [commandId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  transactions   Transaction[]
  payments       PayablePayment[]

  @@index([businessId])
  @@index([commandId])
  @@map("payables")
}

model PayablePayment {
  id              String   @id @default(cuid())
  payableId       String
  payable         Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10, 2)
  paidAt          DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([payableId])
  @@map("payable_payments")
}

// ---------- PRONTUARIO / ANAMNESE ----------
// Modulo ligado por Business.prontuarioEnabled. Ver CLAUDE.md item 9 do MVP:
// STAFF nao acessa dado clinico (decisao de produto), so OWNER/PROFESSIONAL.

model AnamneseRecord {
  id                 String   @id @default(cuid())
  businessId         String
  clientId           String   @unique
  allergies          String?  @db.Text
  medications        String?  @db.Text
  healthConditions   String?  @db.Text
  previousProcedures String?  @db.Text
  contraindications  String?  @db.Text
  notes              String?  @db.Text
  customFields       Json?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client            @relation(fields: [clientId], references: [id])
  consents AnamneseConsent[]
  photos   AnamnesePhoto[]

  @@index([businessId])
  @@map("anamnese_records")
}

model AnamneseConsent {
  id                 String   @id @default(cuid())
  anamneseRecordId   String
  consentText        String   @db.Text
  dataSnapshot       Json
  ipAddress          String?
  userAgent          String?
  registeredByUserId String
  createdAt          DateTime @default(now())

  record AnamneseRecord @relation(fields: [anamneseRecordId], references: [id])

  @@index([anamneseRecordId])
  @@map("anamnese_consents")
}

model AnamneseCustomField {
  id         String            @id @default(cuid())
  businessId String
  label      String
  type       AnamneseFieldType
  order      Int
  createdAt  DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("anamnese_custom_fields")
}

enum AnamneseFieldType {
  TEXT
  BOOLEAN
}

model AnamnesePhoto {
  id               String            @id @default(cuid())
  businessId       String
  clientId         String
  anamneseRecordId String?
  appointmentId    String?
  kind             AnamnesePhotoKind
  blobPathname     String
  uploadedByUserId String
  takenAt          DateTime          @default(now())

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client          @relation(fields: [clientId], references: [id])
  record      AnamneseRecord? @relation(fields: [anamneseRecordId], references: [id])
  appointment Appointment?    @relation(fields: [appointmentId], references: [id])

  @@index([businessId])
  @@index([clientId])
  @@index([appointmentId])
  @@map("anamnese_photos")
}

enum AnamnesePhotoKind {
  ANTES
  DEPOIS
  GERAL
}

model AnamneseAccessLog {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  photoId    String
  userId     String
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@map("anamnese_access_logs")
}
